{% macro heroSlideSources(index, eager) %}
{% set desktop = "/images/slide-" ~ index %}
{% set mobile = "/images/slide-" ~ index ~ "-mob" %}
{% set formats = [
    { type: "image/avif", ext: "avif" },
    { type: "image/webp", ext: "webp" },
    { type: "image/jpeg", ext: "jpg" }
  ] %}

{% for format in formats %}
{% set mobileSrcset = heroSrcset(mobile, format.ext) %}
{% if mobileSrcset %}
<source
  media="(max-width: 765px)"
  type="{{ format.type }}"
  width="375"
  height="525"
  {% if eager %}
  srcset="{{ mobileSrcset }}"
  {% else %}
  data-srcset="{{ mobileSrcset }}"
  {% endif %}
>
{% endif %}
{% endfor %}

{% for format in formats %}
{% set desktopSrcset = heroSrcset(desktop, format.ext) %}
{% if desktopSrcset %}
<source
  type="{{ format.type }}"
  width="1200"
  height="400"
  {% if eager %}
  srcset="{{ desktopSrcset }}"
  {% else %}
  data-srcset="{{ desktopSrcset }}"
  {% endif %}
>
{% endif %}
{% endfor %}
{% endmacro %}

<style>
  .hero {
    width: 100%;
    aspect-ratio: 1200 / 400;
  }

  @media screen and (max-width: 765px) {
    .hero {
      aspect-ratio: 375 / 525;
    }
  }
</style>

<section class="hero container container--no-padding">
  <div class="swiper hero__slider js-hero-slider">
    <div class="swiper-wrapper">
      {% for i in [1, 2, 3] %}
      {% set eager = loop.first %}
      {% set desktop = "/images/slide-" ~ i %}
      {% set desktopSrcset = heroSrcset(desktop, "jpg") %}
      <div class="swiper-slide hero__slide">
        <picture>
          {{ heroSlideSources(i, eager) }}
          <img
            class="hero__slide-image"
            alt="Hero"
            width="1200"
            height="400"
            {% if eager %}decoding="sync"{% else %}decoding="async"{% endif %}
            {% if eager %}
            src="{{ desktop }}@2x.jpg"
            {% if desktopSrcset %}srcset="{{ desktopSrcset }}"{% endif %}
            fetchpriority="high"
            {% else %}
            data-src="{{ desktop }}@2x.jpg"
            {% if desktopSrcset %}data-srcset="{{ desktopSrcset }}"{% endif %}
            {% endif %}
          >
        </picture>
      </div>
      {% endfor %}
    </div>

    <div class="hero__pagination"></div>
  </div>
</section>
