<footer class="footer">
  <div class="container footer__container">
    <div class="footer__top">
      <div class="footer__grid">
        <div class="footer__col footer__col--company">
          <h2 class="footer__title">О компании</h2>

          <ul class="footer__menu">
            <li>
              <a class="footer__link focus hover" href="/activity.html">Деятельность</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Документы</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="/vacancies.html">Вакансии</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="/news.html">Новости</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="/contacts.html">Контакты для связи</a>
            </li>
          </ul>

          {% set button ={
              text: "Оплатить услуги",
              href: notFoundPageUrl,
              variant: "orange",
              class: "footer__pay"
            }
          %}
          {% include "partials/button/button.njk" %}
        </div>

        <div class="footer__col footer__col--services">
          <h2 class="footer__title">Услуги</h2>

          <ul class="footer__menu">
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Интернет для города</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="/private-internet.html">Интернет для частного сектора</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Домофония</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="/home-video-surveillance.html">Видеонаблюдение</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="/television.html">Цифровое ТВ</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Рассрочка</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Услуги для бизнеса</a>
            </li>
          </ul>
        </div>

        <div class="footer__col footer__col--support">
          <h2 class="footer__title">Техподдержка</h2>

          <ul class="footer__menu">
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Обращение в техподдержку</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Заявка на подключение</a>
            </li>
          </ul>
        </div>

        <div class="footer__col footer__col--docs">
          <h2 class="footer__title">Документы</h2>

          <ul class="footer__menu">
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Политика конфиденциальности</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Пользовательское соглашение</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Согласие на обработку персональных данных</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Правила оказания услуг связи</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Договоры и согласия</a>
            </li>
            <li>
              <a class="footer__link focus hover" href="{{ notFoundPageUrl }}">Лицензии</a>
            </li>
          </ul>
        </div>

        <div class="footer__col footer__col--social">
          <h2 class="footer__title">Соцсети</h2>

          <ul class="footer__social">
            <li>
              <a class="footer__social-link focus hover" href="https://vk.ru" target="_blank" rel="noopener noreferrer" aria-label="ВКонтакте">
                {% set icon ={
                    name: "vk",
                    class: "footer__social-icon"
                  }
                %}
                {% include "partials/icon/icon.njk" %}
              </a>
            </li>
            <li>
              <a class="footer__social-link focus hover" href="https://max.ru/" target="_blank" rel="noopener noreferrer" aria-label="Max">
                {% set icon ={
                    name: "max",
                    class: "footer__social-icon"
                  }
                %}
                {% include "partials/icon/icon.njk" %}
              </a>
            </li>
            <li>
              <a class="footer__social-link focus hover" href="https://t.me/" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
                {% set icon ={
                    name: "tg",
                    class: "footer__social-icon"
                  }
                %}
                {% include "partials/icon/icon.njk" %}
              </a>
            </li>
          </ul>
        </div>

        <div class="footer__col footer__col--app">
          <h2 class="footer__title">Скачайте наше приложение на Android</h2>
          <img
            class="footer__qr"
            src="/images/qr.jpg"
            width="130"
            height="130"
            loading="lazy"
            decoding="async"
            alt="QR-код для скачивания приложения"
          >
        </div>
      </div>
    </div>

    <div class="footer__divider" aria-hidden="true"></div>

    <div class="footer__bottom">
      <p class="footer__note">© 2017-2025 Интернет-провайдер «Большие Связи»</p>
    </div>
  </div>
</footer>
